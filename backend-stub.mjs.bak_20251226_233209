import http from "node:http";
import { URL } from "node:url";

const HOST = "127.0.0.1";
const PORT = 8787;

function setCors(req, res) {
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "GET,POST,OPTIONS");
  const reqHdrs = req.headers["access-control-request-headers"];
  res.setHeader("Access-Control-Allow-Headers", reqHdrs || "Content-Type, Authorization");
  res.setHeader("Access-Control-Max-Age", "86400");
}

function readAll(req) {
  return new Promise((resolve) => {
    const chunks = [];
    req.on("data", (c) => chunks.push(c));
    req.on("end", () => resolve(Buffer.concat(chunks)));
  });
}

function sendJson(res, status, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(status, { "Content-Type": "application/json" });
  res.end(body);
}

const server = http.createServer(async (req, res) => {
  setCors(req, res);

  if (req.method === "OPTIONS") {
    res.writeHead(204);
    return res.end();
  }

  const u = new URL(req.url, `http://${HOST}:${PORT}`);
  let path = u.pathname || "/";
  if (path.startsWith("/api/")) path = path.slice(4); // "/api/x" -> "/x"

  if (path === "/health") {
    return sendJson(res, 200, { ok: true, service: "backend-stub", time: new Date().toISOString() });
  }

  const isAi = ["/analyze", "/predict", "/infer", "/ai", "/v1/analyze"].includes(path);
  if (isAi) {
    // Consume body (image/png or json) so the connection is clean
    await readAll(req);

    // Return a demo detection box in normalized coords (0..1)
    return sendJson(res, 200, {
      ok: true,
      model: "stub",
      path,
      detections: [
        { label: "demo", score: 0.91, box: { x: 0.35, y: 0.35, w: 0.25, h: 0.25 } }
      ]
    });
  }

  return sendJson(res, 404, { ok: false, error: "Not Found", path });
});

server.listen(PORT, HOST, () => {
  console.log(`Backend listening on http://${HOST}:${PORT}`);
});
